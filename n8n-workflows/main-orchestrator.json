    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Search available properties in the database. Call this whenever the user asks about properties, prices, cities or bedrooms. Use empty string for city and 0 for max_price or min_bedrooms when the user did not specify them. Prices are in INR (1 lakh = 100000, 1 crore = 10000000).",
        "operation": "executeQuery",
        "query": "SELECT id, title, type, price, city, location, bedrooms, bathrooms, area_sqft FROM properties WHERE ($1::text = '' OR city ILIKE $1::text) AND ($2::numeric = 0 OR price <= $2::numeric) AND ($3::int = 0 OR bedrooms >= $3::int) ORDER BY price ASC LIMIT 5;",
        "options": {
          "queryReplacement": "={{ [ $fromAI('city', 'City name such as Solapur or Pune. Empty string if not specified', 'string'), $fromAI('max_price', 'Maximum price in INR as a number. 0 if not specified', 'number'), $fromAI('min_bedrooms', 'Minimum number of bedrooms. 0 if not specified', 'number') ] }}"
        }
      },
